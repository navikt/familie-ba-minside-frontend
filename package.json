{
  "name": "familie-ba-minside-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack | pino-pretty --messageKey=message",
    "build": "next build",
    "start": "next start",
    "start:dev": "yarn clean && concurrently \"yarn dev\" \"open http://localhost:3000/barnetrygd/min-barnetrygd\"",
    "lint": "next lint",
    "prettier": "prettier -l \"src/**/*.{js,jsx,ts,tsx}\"",
    "prepare": "husky",
    "test": "vitest",
    "clean": "rm -rf dist",
    "validate": "yarn typecheck && yarn lint && yarn prettier",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@navikt/aksel-icons": "8.5.0",
    "@navikt/ds-css": "8.5.0",
    "@navikt/ds-react": "8.5.0",
    "@navikt/nav-dekoratoren-moduler": "3.6.1",
    "@navikt/next-logger": "4.5.1",
    "@navikt/oasis": "3.8.0",
    "csp-header": "6.3.0",
    "html-react-parser": "5.2.17",
    "jsdom": "28.1.0",
    "next": "15.5.9",
    "pino": "10.3.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "unleash-client": "6.9.0",
    "uuid": "13.0.0"
  },
  "devDependencies": {
    "@axe-core/react": "4.11.0",
    "@eslint/eslintrc": "3.3.3",
    "@navikt/aksel": "^8.5.0",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/jest-axe": "3.5.9",
    "@types/node": "24.10.4",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.2",
    "concurrently": "9.2.0",
    "eslint": "9.39.2",
    "eslint-config-next": "15.5.9",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "jest-axe": "10.0.0",
    "msw": "2.12.7",
    "pino-pretty": "13.1.3",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.0.16"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
