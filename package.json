{
  "name": "familie-ba-minside-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev | pino-pretty --messageKey=message",
    "build": "next build",
    "start": "next start",
    "start:dev": "yarn clean && concurrently \"yarn dev\" \"open http://localhost:3000/barnetrygd/min-barnetrygd\"",
    "lint": "eslint .",
    "prettier": "prettier -l \"src/**/*.{js,jsx,ts,tsx}\"",
    "prepare": "husky",
    "test": "vitest",
    "clean": "rm -rf dist",
    "validate": "yarn typecheck && yarn lint && yarn prettier",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@navikt/aksel-icons": "8.11.1",
    "@navikt/ds-css": "8.11.1",
    "@navikt/ds-react": "8.11.1",
    "@navikt/nav-dekoratoren-moduler": "4.2.1",
    "@navikt/next-logger": "5.0.0",
    "@navikt/oasis": "4.1.4",
    "csp-header": "6.3.1",
    "html-react-parser": "6.1.3",
    "jsdom": "29.1.1",
    "next": "16.2.11",
    "pino": "10.3.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "unleash-client": "6.11.0",
    "uuid": "14.0.0"
  },
  "devDependencies": {
    "@axe-core/react": "4.11.3",
    "@navikt/aksel": "^8.11.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/jest-axe": "3.5.9",
    "@types/node": "24.12.4",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "concurrently": "9.2.1",
    "eslint": "10.8.1",
    "eslint-config-next": "16.2.6",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "jest-axe": "10.0.0",
    "msw": "2.14.6",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.8"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
