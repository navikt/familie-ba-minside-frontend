{
  "name": "familie-ba-minside-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack | pino-pretty --messageKey=message",
    "build": "next build",
    "start": "next start",
    "start:dev": "yarn clean && concurrently \"yarn dev\" \"open http://localhost:3000/barnetrygd/min-barnetrygd\"",
    "lint": "next lint",
    "prettier": "prettier -l \"src/**/*.{js,jsx,ts,tsx}\"",
    "prepare": "husky",
    "test": "vitest",
    "clean": "rm -rf dist",
    "validate": "yarn typecheck && yarn lint && yarn prettier",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@navikt/aksel-icons": "^7.30.1",
    "@navikt/ds-css": "^7.30.1",
    "@navikt/ds-react": "^7.30.1",
    "@navikt/nav-dekoratoren-moduler": "^3.4.0",
    "@navikt/next-logger": "^4.1.5",
    "@navikt/oasis": "^3.8.0",
    "csp-header": "^6.1.0",
    "html-react-parser": "^5.2.3",
    "jsdom": "^27.0.0",
    "next": "15.5.0",
    "pino": "^9.12.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "unleash-client": "^6.7.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@axe-core/react": "^4.10.2",
    "@eslint/eslintrc": "^3",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.0",
    "eslint-config-prettier": "^10.1.1",
    "husky": "^9.1.7",
    "jest-axe": "^10.0.0",
    "msw": "^2.11.1",
    "pino-pretty": "^13.1.1",
    "prettier": "^3.6.1",
    "typescript": "^5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
